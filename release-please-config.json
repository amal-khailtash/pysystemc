          "section": "Dependencies"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "docs",
          "section": "Docs",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Style",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Chore",
          "hidden": true
        },
        {
          "type": "refactor",
          "section": "Refactor",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Test",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Ci",
          "hidden": true
        }
      ]
    }
