  "sync_source_sha256": "0f79d4fc8b5b9323d0b031446b8f6eb77dd96e06a7ad2b11b398fe40c6864338",
  "recorder_source": "\"\"\"Run one validation command and refresh the current plan after it finishes.\"\"\"\n\nimport datetime\nimport fcntl\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport runpy\nimport subprocess\nimport sys\nimport xml.etree.ElementTree as ET\n\nroot = Path(__file__).resolve().parents[1]\nlabel, log_name, *command = sys.argv[1:]\nif command and command[0] == \"--\":\n    command.pop(0)\nlog = root / log_name\nlog.parent.mkdir(parents=True, exist_ok=True)\nstarted = datetime.datetime.now(datetime.timezone.utc)\ntimeout_seconds = int(os.environ.get('PYSYSTEMC_VERIFICATION_TIMEOUT_SECONDS', '300'))\nif timeout_seconds <= 0:\n    raise ValueError('PYSYSTEMC_VERIFICATION_TIMEOUT_SECONDS must be positive')\nwith log.open(\"w\") as output:\n    try:\n        result = subprocess.run(command, cwd=root, stdout=output, stderr=subprocess.STDOUT, timeout=timeout_seconds)\n        code = result.returncode\n    except subprocess.TimeoutExpired:\n        code = 124\nrecord = {\n    \"label\": label,\n    \"finished_utc\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    \"seconds\": round((datetime.datetime.now(datetime.timezone.utc) - started).total_seconds(), 2),\n    \"exit_code\": code,\n    \"status\": \"passed\" if code == 0 else \"failed\",\n    \"log\": log_name,\n    \"command\": command,\n}\nfor argument in command:\n    if argument.startswith(\"--junitxml=\"):\n        record[\"junit\"] = argument.split(\"=\", 1)[1]\n        if (root / record[\"junit\"]).exists():\n            suites = list(ET.parse(root / record[\"junit\"]).getroot().iter(\"testsuite\"))\n            record[\"tests\"] = sum(int(s.attrib.get(\"tests\", 0)) for s in suites)\n            record[\"failures\"] = sum(int(s.attrib.get(\"failures\", 0)) + int(s.attrib.get(\"errors\", 0)) for s in suites)\n            record[\"skipped\"] = sum(int(s.attrib.get(\"skipped\", 0)) for s in suites)\n# Serialize run-ledger and plan writes after independently running commands.\nprogress_lock = (root / \".ai/verification-progress.lock\").open(\"a\")\nfcntl.flock(progress_lock, fcntl.LOCK_EX)\nrecords_path = root / \".ai/VERIFICATION_RUNS.json\"\nrecords = json.loads(records_path.read_text()) if records_path.exists() else []\nrecords.append(record)\nrecords_path.write_text(json.dumps(records, indent=2) + \"\\n\")\nledger = json.loads((root / \".ai/VERIFICATION_PROGRESS.json\").read_text())\nreviewed = sum(r[\"status\"] != \"not reviewed\" for r in ledger[\"api_declarations\"])\ntotal = len(ledger[\"api_declarations\"])\nplan = root / \".ai/VERIFICATION_AND_PERFORMANCE_PLAN.md\"\ns = plan.read_text()\ns = re.sub(r\"^\\| Public declaration verification in this cycle .*?$\", f\"| Public declaration verification in this cycle | {reviewed:,} / {total:,} reviewed; 0 verified | {reviewed / total:.2%} reviewed | {total-reviewed:,} unreviewed; all {total:,} still need complete contract verification |\", s, flags=re.M)\nsection = [\"<!-- validation-run-updates-start -->\", \"## Latest validation runs\", \"\", \"Update this plan after every validation run, including failures. Refresh HANDOFF.md after each accepted batch and before context gets tight; the user starts a new session, which must read that handoff first. Use `.venv/bin/python .ai/record_verification_run.py LABEL LOG -- COMMAND` so completion records the outcome before acceptance. Complete command history is in `VERIFICATION_RUNS.json`.\", \"\", \"| Run | Result | Evidence |\", \"|---|---|---|\"]\nfor row in records[-8:]:\n    duration = f\"{row['seconds']:.2f}s\" if row.get(\"seconds\") is not None else \"duration unrecorded\"\n    result = f\"{row['status']}; exit {row['exit_code']}; {duration}\"\n    if \"tests\" in row:\n        result += f\"; {row['tests']} tests, {row['failures']} failures/errors, {row['skipped']} skips\"\n    section.append(f\"| {row['label']} | {result} | `{row['log']}` |\")\nsection += [\"\", \"<!-- validation-run-updates-end -->\", \"\"]\nblock = \"\\n\".join(section)\nif \"<!-- validation-run-updates-start -->\" in s:\n    s = re.sub(r\"<!-- validation-run-updates-start -->.*?<!-- validation-run-updates-end -->\\n?\", block, s, flags=re.S)\nelse:\n    position = s.index(\"## Progress at a glance\")\n    s = s[:position] + block + \"\\n\" + s[position:]\nplan.write_text(s)\nrunpy.run_path(str(root / \".ai/sync_verification_plan.py\"))\nprint(json.dumps(record))\nsys.exit(code)\n",
